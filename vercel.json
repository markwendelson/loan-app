{
    "version": 2,
    "builds": [
        {
            "src": "public/index.php",
            "use": "@vercel/php"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "headers": { "X-Frame-Options": "SAMEORIGIN" },
            "continue": true
        },
        {
            "src": "/(.*)",
            "dest": "/"
        }
    ]
}