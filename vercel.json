{
    "version": 2,
    "framework" : null,
    "functions" : {
        "api/index.php" : { "runtime": "vercel-php@0.6.0" }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest" : "/api/index.php",
        },
        {
            "src": "/(.*)",
            "dest": "/"
        }
    ],
    "env" : {
        "APP_ENV" : "development",
        "APP_DEBUG" : "true",
    }
}